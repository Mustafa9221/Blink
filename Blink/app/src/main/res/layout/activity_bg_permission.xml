<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617">

    <!-- Centered container -->
    <LinearLayout
        android:id="@+id/container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Icon -->
        <TextView
            android:id="@+id/tvIconBg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="48sp"/>

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitleBg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow Foreground Access"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"/>

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescBg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Blink needs to run in the background so it can keep your focus session active, track screen usage, and remind you to take breaks — even when the app is closed."
            android:textSize="16sp"
            android:textColor="#CBD5E1"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="12dp"/>

        <!-- Grant Button -->
        <Button
            android:id="@+id/btnGrantForegroundService"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Allow Foreground Service Access"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#020617"
            android:backgroundTint="#22D3EE"
            android:layout_marginTop="24dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
