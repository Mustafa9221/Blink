<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="Theme.Blink" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#38BDF8</item>
        <item name="colorOnPrimary">#0F172A</item>

        <!-- Background -->
        <item name="android:windowBackground">#0F172A</item>

        <!-- Status & navigation bars -->
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>

        <!-- Light icons on dark bars -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

</resources>
